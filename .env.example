# The API, as the Next.js server reaches it. Can be an internal address.
API_URL=http://localhost:8000
# The API, as the browser reaches it. Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sign-in through Keycloak (Auth.js). The local Keycloak comes from the API repository's
# compose.yaml; its realm already has this client.
# This site's own address, which Auth.js builds its callback URLs from.
AUTH_URL=http://localhost:3000
# Encrypts the session cookie. Generate one per environment: `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_KEYCLOAK_ID=phenomena-atlas-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/phenomena-atlas

# The basemap: a MapLibre style URL. Empty shows a plain background under the data layers.
# OpenFreeMap's free style is a development default; the production basemap is not decided.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
